          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select cast(r.${group_by} as text) as \"group\", count(*) as runs,\n  avg(r.result_pct) as result_value_pct, avg(r.result_pct_usd) as result_usd_pct,\n  min(r.result_pct_usd) as worst_usd_pct, max(r.result_pct_usd) as best_usd_pct,\n  avg(r.hold_value_pct_usd) as holding_value_usd_pct,\n  avg(r.fees / r.start_capital * 100 * 365.0 / (r.window_to::date - r.window_from::date + 1)) as fee_apr_pct,\n  avg((select 100.0 * count(*) filter (where state = 'in_range') / nullif(count(*), 0) from series s where s.run_id = r.run_id)) as in_range_pct,\n  avg((select 100.0 * count(*) filter (where state in ('beyond', 'flipped')) / nullif(count(*), 0) from series s where s.run_id = r.run_id)) as out_of_range_pct,\n  avg(r.campaigns) as campaigns, avg(r.max_drawdown_pct) as max_drawdown_pct\nfrom runs r where r.experiment in ($experiment)\ngroup by 1 order by result_usd_pct desc"
