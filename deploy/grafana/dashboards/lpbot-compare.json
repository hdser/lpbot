{
  "uid": "lpbot-compare",
  "title": "lpbot: compare",
  "description": "Runs and strategies side by side: value curves in dollars and in the value token against holding ETH and holding dollars, their figures in a table, and every run of the chosen experiments averaged by rule, value token, width, pool or settings.",
  "tags": [
    "lpbot"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-2y",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "experiment",
        "label": "Experiments",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "query": "select distinct experiment from runs order by 1",
        "definition": "select distinct experiment from runs order by 1",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": false
      },
      {
        "name": "runs",
        "label": "Runs to compare",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "query": "select r.run_id as __value, r.experiment || ' ' || lpad(r.run_index::text, 3, '0') || ' ' || r.pool || ' ' || r.value_token || ' ' || r.width_ticks || 't ' || r.patience || '  ' || coalesce(r.sweep, '') as __text\nfrom runs r where r.experiment in ($experiment) order by r.experiment, r.run_index",
        "definition": "select r.run_id as __value, r.experiment || ' ' || lpad(r.run_index::text, 3, '0') || ' ' || r.pool || ' ' || r.value_token || ' ' || r.width_ticks || 't ' || r.patience || '  ' || coalesce(r.sweep, '') as __text\nfrom runs r where r.experiment in ($experiment) order by r.experiment, r.run_index",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "group_by",
        "label": "Group by",
        "type": "custom",
        "query": "patience,value_token,width_ticks,pool,sweep,experiment",
