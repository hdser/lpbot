      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select r.experiment || ' ' || lpad(r.run_index::text, 3, '0') || ' ' || r.pool || ' ' || r.value_token || ' ' || r.width_ticks || 't ' || r.patience as run, r.sweep,\n  r.result_pct as result_value_pct, r.result_pct_usd as result_usd_pct, r.hold_value_pct_usd as holding_value_usd_pct,\n  r.result_pct * 365.0 / (r.window_to::date - r.window_from::date + 1) as apr_pct, r.fees / r.start_capital * 100 * 365.0 / (r.window_to::date - r.window_from::date + 1) as fee_apr_pct,\n  (r.end_capital - r.start_capital) - r.fees + r.gas as divergence,\n  (select 100.0 * count(*) filter (where state = 'in_range') / nullif(count(*), 0) from series s where s.run_id = r.run_id) as in_range_pct,\n  (select 100.0 * count(*) filter (where state in ('beyond', 'flipped')) / nullif(count(*), 0) from series s where s.run_id = r.run_id) as out_of_range_pct,\n  (select max(seconds_beyond) / 86400.0 from campaigns c where c.run_id = r.run_id) as longest_out_days,\n  r.campaigns, r.passes, r.max_drawdown_pct, r.window_from, r.window_to\nfrom runs r where r.run_id in ($runs) order by r.result_pct_usd desc"
        }
      ],
