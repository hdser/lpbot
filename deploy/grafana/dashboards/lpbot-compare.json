    {
      "id": 101,
      "title": "Value in dollars, start = 100, against holding ETH and holding dollars",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select date_trunc('hour', to_timestamp(s.time)) as time, r.experiment || ' ' || lpad(r.run_index::text, 3, '0') || ' ' || r.pool || ' ' || r.value_token || ' ' || r.width_ticks || 't ' || r.patience as metric, avg(s.equity_usd / r.start_usd * 100) as value\nfrom series s join runs r using (run_id) where r.run_id in ($runs) group by 1, 2\nunion all\nselect date_trunc('hour', to_timestamp(s.time)), 'holding the volatile token',\n  avg(case when r.start_usd = r.start_capital then r.start_price / s.price else s.price / r.start_price end * 100)\nfrom series s join runs r using (run_id) where r.run_id = (select min(run_id) from runs where run_id in ($runs)) group by 1\nunion all\nselect date_trunc('hour', to_timestamp(s.time)), 'holding dollars', 100\nfrom series s join runs r using (run_id) where r.run_id = (select min(run_id) from runs where run_id in ($runs)) group by 1\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "holding the volatile token"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c0c0c0"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "holding dollars"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6e7781"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    8
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
