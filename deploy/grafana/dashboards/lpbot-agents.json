    {
      "type": "table",
      "title": "Scores by agent and horizon",
      "description": "Each decision left alone for the horizon, against the actions not taken, replayed by the same engine. Edge over cash: the decision's result less staying in cash (or exiting), in percent of the capital, on average. Edge over holding: the same against keeping the open position, for decisions taken with one open. Regret: the best alternative less the decision, summed. Best: the share of decisions that did at least as well as every alternative. Band held: how often price stayed in the band the agent expected until its next look; Brier: the square of the miss of its stated confidence (0 is perfect, 0.25 is a coin).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select agent, model, horizon, count(*) as decisions,\n  avg(edge_vs_cash_pct) as \"edge over cash %\", avg(edge_vs_hold_pct) as \"edge over holding %\", count(edge_vs_hold_pct) as \"with a position open\",\n  sum(regret_pct) as \"regret %\", 100.0 * avg(case when best = 'decision' then 1.0 else 0.0 end) as \"best %\",\n  100.0 * avg(case when band_held then 1.0 when band_held is not null then 0.0 end) as \"band held %\", count(band_held) as \"bands\",\n  avg(brier) as \"Brier\"\nfrom agent_scores where run_id in ($run)\ngroup by agent, model, horizon order by horizon <> 'next', horizon, agent"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
