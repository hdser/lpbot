    {
      "type": "table",
      "title": "Agents side by side",
      "description": "One row per agent's run. Peers shown: looks that handed it peers' records. Holding: what holding the value token did, in dollars. Click an agent to set the time range to the run's window; click a run id to open it in the run detail dashboard.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
