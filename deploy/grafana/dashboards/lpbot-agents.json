    {
      "type": "timeseries",
      "title": "Each agent's result, in percent of its capital",
      "description": "The run's equity, marked at the pool price, in the value token, from the series table (one point every sim.series_every).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select to_timestamp(s.time) as time, a.agent || ' (' || a.model || ')' as metric, (s.equity / r.start_capital - 1) * 100 as value\nfrom series s join runs r on r.run_id = s.run_id join (select run_id, min(agent) as agent, min(model) as model, count(*) as looks, count(stance) as with_peers from agent_looks where run_id in ($run) group by run_id) a on a.run_id = s.run_id\nwhere $__unixEpochFilter(s.time)\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false
          }
