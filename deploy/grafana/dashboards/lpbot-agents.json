          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select a.agent, a.model, a.looks, a.with_peers as \"peers shown\", r.result_pct as \"result %\", r.result_pct_usd as \"in $ %\",\n  r.hold_value_pct_usd as \"holding, in $ %\", r.max_drawdown_pct as \"max drawdown %\", r.campaigns, r.passes as \"round trips\",\n  r.fees, r.gas, r.value_token, r.window_from, r.window_to, r.run_id,\n  (extract(epoch from r.window_from::date) * 1000)::bigint as from_ms,\n  (extract(epoch from r.window_to::date + 1) * 1000)::bigint as to_ms\nfrom (select run_id, min(agent) as agent, min(model) as model, count(*) as looks, count(stance) as with_peers from agent_looks where run_id in ($run) group by run_id) a join runs r on r.run_id = a.run_id\norder by a.agent"
        }
