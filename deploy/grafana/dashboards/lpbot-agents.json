    {
      "type": "timeseries",
      "title": "Price in dollars, and each agent's range",
      "description": "The pool price in dollars, and the bounds of each agent's open range in the same price.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select time, metric, value from (\n  select to_timestamp(s.time) as time, 'price' as metric,\n    case when r.start_usd = r.start_capital then 1 / s.price else s.price end as value\n  from series s join runs r on r.run_id = s.run_id\n  where s.run_id = (select min(run_id) from agent_looks where run_id in ($run)) and $__unixEpochFilter(s.time)\n  union all\n  select to_timestamp(s.time), a.agent || ' range low',\n    case when r.start_usd = r.start_capital then 1 / s.price_upper else s.price_lower end\n  from series s join runs r on r.run_id = s.run_id join (select run_id, min(agent) as agent, min(model) as model, count(*) as looks, count(stance) as with_peers from agent_looks where run_id in ($run) group by run_id) a on a.run_id = s.run_id\n  where s.price_lower is not null and $__unixEpochFilter(s.time)\n  union all\n  select to_timestamp(s.time), a.agent || ' range high',\n    case when r.start_usd = r.start_capital then 1 / s.price_lower else s.price_upper end\n  from series s join runs r on r.run_id = s.run_id join (select run_id, min(agent) as agent, min(model) as model, count(*) as looks, count(stance) as with_peers from agent_looks where run_id in ($run) group by run_id) a on a.run_id = s.run_id\n  where s.price_upper is not null and $__unixEpochFilter(s.time)\n) x order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
