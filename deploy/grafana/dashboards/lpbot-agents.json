{
  "uid": "lpbot-agents",
  "title": "lpbot: agents",
  "description": "Agent runs side by side: each agent's result, how its decisions scored against cash and holding, how it stood toward its peers, and every look with what it saw, decided, expected and why. From the agent tables (agent_looks, agent_scores) and the runs and series tables.",
  "tags": [
    "lpbot"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-2y",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "experiment",
        "label": "Experiment",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "query": "select distinct r.experiment from runs r where exists (select 1 from agent_looks l where l.run_id = r.run_id) order by 1",
        "definition": "select distinct r.experiment from runs r where exists (select 1 from agent_looks l where l.run_id = r.run_id) order by 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "run",
        "label": "Agents",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "query": "select distinct l.run_id as __value, l.agent || ' (' || l.model || ')' as __text from agent_looks l join runs r on r.run_id = l.run_id where r.experiment = '$experiment' order by 2",
        "definition": "select distinct l.run_id as __value, l.agent || ' (' || l.model || ')' as __text from agent_looks l join runs r on r.run_id = l.run_id where r.experiment = '$experiment' order by 2",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "horizon",
        "label": "Horizon",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "query": "select distinct horizon from agent_scores s join runs r on r.run_id = s.run_id where r.experiment = '$experiment' order by 1 desc",
        "definition": "select distinct horizon from agent_scores s join runs r on r.run_id = s.run_id where r.experiment = '$experiment' order by 1 desc",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Entries and exits",
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 152, 48, 0.9)",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select to_timestamp(time) as time,\n  agent || ' look ' || number || ': ' || action || case when action = 'enter' then ' ' || (case when lower_pct >= 0 then '+' else '' end || round((lower_pct)::numeric, 2) || '%') || ' to ' || (case when upper_pct >= 0 then '+' else '' end || round((upper_pct)::numeric, 2) || '%') else '' end || coalesce('. ' || nullif(note, ''), '') as text,\n  agent || ',' || action as tags\nfrom agent_looks where run_id in ($run) and action in ('enter', 'exit') and $__unixEpochFilter(time) order by 1"
        }
      }
    ]
  },
