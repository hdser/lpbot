    {
      "type": "table",
      "title": "Every agent now",
      "description": "Every forward agent on the node, from `lpbot supervisor status`, checked every minute. Lateness counts from the look's due time. Next look: seconds until it is due, negative when it is overdue. Scheduler is kept apart from the agent: a waiting process or a runner's files show activity, not health. Red states need someone; deploy/RUNBOOK.md, \"Is every agent working?\", says what to do. Click an agent to see its runs below.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select agent, model, experiment, runner, state,\n  due - extract(epoch from now())::bigint as \"next look\",\n  to_timestamp(last_time) as \"last look\",\n  coalesce(last_action || coalesce(' ' || last_range, ''), 'none') as \"last decision\",\n  listening, detail, scheduler, run_id\nfrom agent_status\norder by case when state in ('late','no waiter','stopped','failing','scheduler down') then 0 else 1 end, experiment, agent"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "agent"
            },
            "properties": [
