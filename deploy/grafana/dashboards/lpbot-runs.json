{
  "uid": "lpbot-runs",
  "title": "Runs: experiments",
  "description": "Which experiments are there, and how did the runs of one do? Click an experiment in the first table to show its runs; click a run to open it. Results are in the value token and in dollars. Times are UTC.",
  "tags": [
    "lpbot",
    "runs"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-2y",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "experiment",
        "label": "Experiment",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "query": "select experiment as __value, experiment || ' (' || count(*) || ' runs)' as __text from runs group by experiment order by max(window_to) desc, experiment",
        "definition": "select experiment as __value, experiment || ' (' || count(*) || ' runs)' as __text from runs group by experiment order by max(window_to) desc, experiment",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },
