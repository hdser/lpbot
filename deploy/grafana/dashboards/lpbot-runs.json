{
  "uid": "lpbot-runs",
  "title": "lpbot: runs",
  "description": "Every run of an experiment side by side. Results are in the value token and in dollars; fees and gas are in the value token.",
  "tags": [
    "lpbot"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-2y",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "experiment",
        "label": "Experiment",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "query": "select distinct experiment from runs order by 1",
        "definition": "select distinct experiment from runs order by 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Runs",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select run_id, patience, width_ticks, pool, value_token, result_pct, result_pct_usd, hold_value_pct_usd,\n  result_pct * 365.0 / (window_to::date - window_from::date + 1) as apr_pct,\n  fees / start_capital * 100 * 365.0 / (window_to::date - window_from::date + 1) as fee_apr_pct,\n  (end_capital - start_capital) - fees + gas as divergence, fees, gas, campaigns, passes, max_drawdown_pct, halted_by_loss_limit, mode, window_from, window_to, capital_usd, loss_limit_pct,\n  (extract(epoch from window_from::date) * 1000)::bigint as from_ms,\n  (extract(epoch from window_to::date + 1) * 1000)::bigint as to_ms\nfrom runs\nwhere experiment = '$experiment'\norder by run_index"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this run in detail",
                    "url": "/d/lpbot-run?var-experiment=${experiment}&var-run=${__value.raw}&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}&timezone=utc"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "result_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max_drawdown_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "result_pct_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hold_value_pct_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "apr_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fee_apr_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Click a run id to open that run in detail, with the time range set to its window."
    },
    {
      "id": 2,
      "title": "Result by run, in percent of the starting capital: value token and dollars",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select pool || ' ' || value_token || ' ' || width_ticks || 't ' || patience as run,\n  result_pct as \"value token\", result_pct_usd as dollars\nfrom runs\nwhere experiment = '$experiment'\norder by run_index"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xField": "run",
        "barWidth": 0.8
      }
    },
    {
      "id": 3,
      "title": "Result by pool, value token, width and rule",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select pool, value_token, width_ticks, patience,\n  avg(result_pct) as result_pct, avg(result_pct_usd) as result_pct_usd,\n  avg(hold_value_pct_usd) as holding_pct_usd,\n  avg(fees / start_capital * 100 * 365.0 / (window_to::date - window_from::date + 1)) as fee_apr_pct,\n  avg(max_drawdown_pct) as max_drawdown_pct,\n  avg(fees) as fees, avg(passes) as passes\nfrom runs\nwhere experiment = '$experiment'\ngroup by 1, 2, 3, 4\norder by 1, 2, 3, 4"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "width_ticks"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fees"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "passes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Widths below a pool's tick spacing are widened to it, so they repeat; the figures are averaged over such repeats. Holding is what the value token did in dollars."
    },
    {
      "id": 4,
      "title": "How campaigns ended",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select r.pool, r.value_token, r.patience, r.width_ticks, c.exit_reason, count(*) as campaigns,\n  sum(c.result) as result, sum(c.fees) as fees, sum(c.passes) as passes\nfrom campaigns c join runs r using (run_id)\nwhere r.experiment = '$experiment'\ngroup by 1, 2, 3, 4, 5\norder by 1, 2, 4, 3, 5"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
