          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select count(*) filter (where state not in ('late','no waiter','stopped','failing','scheduler down')) as \"fine\", count(*) filter (where state in ('late','no waiter','stopped','failing','scheduler down')) as \"need someone\", coalesce(extract(epoch from now())::bigint - max(checked), 999999) as \"status age\" from agent_status"
