    {
      "type": "table",
      "title": "Every forward agent",
      "description": "One row an agent, whatever runs it. Next look in: time until its next look is due, negative when it is late. Last decision: what it did at its last look, and the range in percent from the price. Result: the run's result so far in its value token, updated every hour. Click an agent to see it on Agents.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select s.agent, s.model, s.experiment as panel, s.state,\n  s.due - extract(epoch from now())::bigint as \"next look in\",\n  coalesce(s.last_action || coalesce(' ' || s.last_range, ''), 'none') as \"last decision\",\n  s.looks, r.result_pct as \"result, %\", s.run_id,\n  (extract(epoch from r.window_from::date) * 1000)::bigint as from_ms,\n  (extract(epoch from r.window_to::date + 1) * 1000)::bigint as to_ms\nfrom agent_status s left join runs r on r.run_id = s.run_id\norder by case when s.state in ('late','no waiter','stopped','failing','scheduler down') then 0 else 1 end, s.experiment, s.agent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "agent"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this agent on Agents",
                    "url": "/d/lpbot-agents?var-experiment=${__data.fields.panel}&var-agent=${__data.fields.run_id}&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}&timezone=utc"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "waiting": {
                        "color": "green",
                        "index": 0
                      },
                      "deciding": {
                        "color": "blue",
                        "index": 1
