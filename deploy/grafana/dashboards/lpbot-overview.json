    {
      "type": "table",
      "title": "Needs attention",
      "description": "Everything that needs someone now: agents in a red state, an agent status that is not being written, and a watcher that has stopped, each with what to do: the commands to type on the node machine, in ~/lpbot. Since is when the agent's look was due, or when the status or the watcher last wrote. Click a row's first column to open where the detail is. One green row means all is well.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "with problems as (\n  select 1 as rank, s.agent as what, s.experiment as \"where\", s.state, s.detail as \"what is wrong\",\n    s.what_to_do as \"what to do\", to_timestamp(s.due) as since,\n    '/d/lpbot-agents?var-experiment=' || s.experiment || '&var-agent=' || s.run_id as link\n  from agent_status s where s.state in ('late','no waiter','stopped','failing','scheduler down')\n  union all\n  select 2, 'agent status', 'cron on the node', 'stale',\n    'The agent status was last written ' || coalesce(round((extract(epoch from now()) - max(checked)) / 60) || ' minutes ago', 'never') || '.',\n    'On the node machine: crontab -l should list deploy/agents/refresh.sh --looks; run it by hand and read logs/agent-refresh.log.',\n    to_timestamp(max(checked)), '/d/lpbot-agents'\n  from agent_status having coalesce(extract(epoch from now())::bigint - max(checked), 999999) > 600\n  union all\n  select 3, 'watcher', 'the node', 'stale',\n    'The watcher last wrote ' || coalesce(round((extract(epoch from now()) - max(updated)) / 60) || ' minutes ago', 'never') || ': the watcher or the database has stopped.',\n    'On the node machine: make watch-logs; if it has stopped, make watch-start.',\n    to_timestamp(max(updated)), '/d/lpbot-live'\n  from live_pools having coalesce(extract(epoch from now())::bigint - max(updated), 999999) > 120\n)\nselect what, \"where\", state, \"what is wrong\", \"what to do\", since, link from problems\nunion all\nselect 'nothing needs you now', '', 'fine', 'Every agent is fine, its status is current and the watcher is writing.', '', null, '/d/lpbot-agents'\nwhere not exists (select 1 from problems)\norder by 6 nulls last"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "what"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open where the detail is",
                    "url": "${__data.fields.link}"
                  }
                ]
