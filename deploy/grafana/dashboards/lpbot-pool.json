          "rawSql": "select to_timestamp(time) as time, liquidity from pool_series where pool = '$pool' and $__unixEpochFilter(time) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "The pool's liquidity in range at the price, in its own units: the depth a swap meets."
    }
  ]
