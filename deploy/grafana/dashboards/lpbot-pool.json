{
  "uid": "lpbot-pool",
  "title": "lpbot: pool",
  "description": "One pool over its stored history: price, value held by positions, volume, fees, how busy it is for its size, and the liquidity around the price now and over time. Filled by `lpbot pool-stats` and `lpbot load-results`.",
  "tags": [
    "lpbot"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "pool",
        "label": "Pool",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "results"
        },
        "query": "select pool as __value, max(pool_name) as __text from pool_series group by pool order by 2",
        "definition": "select pool as __value, max(pool_name) as __text from pool_series group by pool order by 2",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Now",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "with s as (select * from pool_series where pool = '$pool'),\nlast as (select * from s where time = (select max(time) from pool_series where pool = '$pool')),\nday as (select sum(volume_usd) as volume, sum(fees_usd) as fees, sum(swaps) as swaps\n        from s where time > (select max(time) from pool_series where pool = '$pool') - 86400)\nselect last.price, last.price_unit as \"price in\", last.tvl_usd as \"value held by positions, $\",\n  day.volume as \"volume 24h, $\", day.fees as \"fees 24h, $\", day.swaps as \"swaps 24h\",\n  day.volume / nullif(last.tvl_usd, 0) * 100 as \"volume / value 24h %\",\n  day.fees * 365 / nullif(last.tvl_usd, 0) * 100 as \"fee yield on value, APR %\",\n  to_timestamp(last.time) as \"as of\"\nfrom last, day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*, \\$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "swaps 24h"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/.*/"
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "The latest sample of the stored history. The value held by positions is what every position holds at the price; it leaves out fees earned but not collected, which sites that show the pool's token balances count in."
    },
    {
      "id": 2,
      "title": "Price",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select to_timestamp(time) as time, price from pool_series where pool = '$pool' and $__unixEpochFilter(time) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Hourly, at the pool price: the dollar price of the pool's other token, or token1 per token0 without a dollar stable."
    },
    {
      "id": 3,
      "title": "Value held by positions",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select to_timestamp(time) as time, tvl_usd as value from pool_series where pool = '$pool' and $__unixEpochFilter(time) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Volume per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select date_trunc('day', to_timestamp(time)) as time, sum(volume_usd) as volume\nfrom pool_series where pool = '$pool' and $__unixEpochFilter(time) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Fees swappers paid per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select date_trunc('day', to_timestamp(time)) as time, sum(fees_usd) as fees\nfrom pool_series where pool = '$pool' and $__unixEpochFilter(time) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Volume over value held, per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select date_trunc('day', to_timestamp(time)) as time, sum(volume_usd) / nullif(avg(tvl_usd), 0) * 100 as volume_over_value_pct\nfrom pool_series where pool = '$pool' and $__unixEpochFilter(time) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "How many times over the liquidity traded in a day: the pool's own measure of how busy it is for its size."
    },
    {
      "id": 7,
      "title": "Liquidity around the price now, in dollars",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select round(price_mid::numeric, greatest(0, 5 - floor(log(abs(price_mid)))::int))::text as price, volatile_usd as \"held in the volatile token\", dollar_usd as \"held in dollars\"\nfrom pool_liquidity\nwhere pool = '$pool' and time = (select max(time) from pool_liquidity where pool = '$pool')\norder by price_mid"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "price",
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "never",
        "barWidth": 0.95,
        "groupWidth": 0.95,
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 60,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "What positions hold in each bucket of prices at the latest daily sample. Below the price they hold the dollar side, above it the other token; the bucket with both colours holds the price."
    },
    {
      "id": 8,
      "title": "Liquidity around the price over time, in dollars",
      "type": "heatmap",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select to_timestamp(time) as time, round(price_mid::numeric, greatest(0, 5 - floor(log(abs(price_mid)))::int))::text as metric, value_usd as value\nfrom pool_liquidity\nwhere pool = '$pool' and $__unixEpochFilter(time)\norder by 1, price_mid"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "rowsFrame": {
          "layout": "auto"
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "fill": "dark-orange",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64,
          "reverse": false
        },
        "cellGap": 0,
        "tooltip": {
          "mode": "single",
          "yHistogram": false,
          "showColorScale": true
        },
        "legend": {
          "show": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        }
      },
      "description": "What positions held in each bucket of prices, day by day, within the span around the price that day. Brighter is more. The price runs through the band where both sides meet."
    },
    {
      "id": 9,
      "title": "Active liquidity at the price",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
