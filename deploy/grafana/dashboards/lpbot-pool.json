    {
      "id": 7,
      "title": "Liquidity around the price now, in dollars",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "results"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "results"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select round(price_mid::numeric, greatest(0, 5 - floor(log(abs(price_mid)))::int))::text as price, volatile_usd as \"held in the base token\", dollar_usd as \"held in the quote token\"\nfrom pool_liquidity\nwhere pool = '$pool' and time = (select max(time) from pool_liquidity where pool = '$pool')\norder by price_mid"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "price",
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "never",
        "barWidth": 0.95,
        "groupWidth": 0.95,
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 60,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "What positions hold in each bucket of prices at the latest daily sample, in dollars. The price is quote token per base token: USDC per WETH, WETH per WBTC. Below the price positions hold the quote token, above it the base token; the bucket with both colours holds the price."
    },
