+#[tokio::test]
+async fn lpbot_tools_off_policy_is_captured_at_real_session_startup() -> anyhow::Result<()> {
+    let session = make_session_with_config(|config| {
+        config.ephemeral = true;
+        config.features.enable(Feature::ShellTool).unwrap();
+        config.features.enable(Feature::CodeMode).unwrap();
+    })
+    .await?;
+    assert_eq!(session.tool_policy.allowed_tools, Some(Vec::new()));
+    for name in ["apply_patch", "exec_command", "exec", "wait", "update_plan"] {
+        assert!(
+            !session
+                .tool_policy
+                .allows(&codex_tools::ToolName::plain(name))
+        );
+    }
+    Ok(())
+}
