# Copied to deploy/.env by scripts/up.sh on first use. deploy/.env is never committed.

# Where node data, Postgres and dashboards live. Point this at the NVMe drive.
# An archive node needs about 3 TB free; a full node about 1.5 TB.
DATA_DIR=./data

# Client versions. Pinned on purpose: upgrade by changing these and running `make up`.
RETH_VERSION=v2.10.1
LIGHTHOUSE_VERSION=v8.2.1

# Empty runs Reth as an archive node, which the replay checks need.
# Set to --full for a pruned full node (less disk, no deep history).
RETH_EXTRA_ARGS=

# Where Lighthouse fetches a recent finalized checkpoint to start from.
CHECKPOINT_SYNC_URL=https://sync-mainnet.beaconcha.in

# Generated by scripts/up.sh on first use.
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=

# Filled in by scripts/up.sh so bind-mounted folders stay owned by you.
HOST_UID=
HOST_GID=
